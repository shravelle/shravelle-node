{
  "name": "@shravelle/node",
  "version": "1.0.0",
  "description": "Shravelle APM for Node.js: traces, metrics, logs and errors via OpenTelemetry with zero-config auto-instrumentation (Express, Fastify, NestJS, Koa, Hapi, Next.js, http, pg, mysql, mongodb, redis, kafkajs, grpc, aws-sdk ...)",
  "main": "dist/index.js",
  "types": "index.d.ts",
  "bin": {
    "shravelle-node": "dist/bin/shravelle-node.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": "./dist/register.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.d.ts"
  ],
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.24.2"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.52.1",
    "@opentelemetry/auto-instrumentations-node": "^0.48.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.52.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.52.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.52.1",
    "@opentelemetry/resources": "^1.25.1",
    "@opentelemetry/sdk-logs": "^0.52.1",
    "@opentelemetry/sdk-metrics": "^1.25.1",
    "@opentelemetry/sdk-node": "^0.52.1",
    "@opentelemetry/sdk-trace-base": "^1.25.1"
  }
}
